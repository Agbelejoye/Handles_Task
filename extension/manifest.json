{
  "manifest_version": 3,
  "name": "Task Handler AI – Activity Tracker",
  "version": "1.0.0",
  "description": "Tracks browser activity and syncs to Task Handler AI. Opt-in only.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://localhost:3000/*", "https://*.taskhandler.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Task Handler AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
